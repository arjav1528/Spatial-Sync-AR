# NextAuth
NEXTAUTH_SECRET=your-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# AWS General
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# S3
S3_BUCKET_NAME=spatialsync-assets-your-account-id

# DynamoDB
DYNAMODB_TABLE_NAME=SpatialSync_Prod

# WebSocket (client-side, prefix with NEXT_PUBLIC_)
NEXT_PUBLIC_WEBSOCKET_URL=wss://your-api-id.execute-api.ap-south-1.amazonaws.com/prod
